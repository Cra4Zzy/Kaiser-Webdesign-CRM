# Nur auf dem Backend-Host konfigurieren. Niemals in Git oder Frontend eintragen!
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
DATABASE_URL=postgresql://kaiser_crm_app.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
CRM_PUBLIC_URL=https://crm.kaiser-webdesign.de
PGSSLMODE=verify-full
